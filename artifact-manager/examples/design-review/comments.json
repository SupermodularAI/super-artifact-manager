      "page": "index.html",
      "agent": "claude-code",
      "comment": "Usage bars use a custom cyan to purple gradient and have no accessible value. Use ProgressBar with tone=\"neutral\", which also exposes aria-valuenow. Switch to tone=\"warning\" above 80%.",
      "createdAt": "2026-11-11T09:10:00.000Z",
      "selector": "#usage",
      "links": [
        {
          "label": "Acme UI: ProgressBar",
          "url": "https://ui.acme.example/components/progress-bar#tones"
        }
      ],
      "area": {
        "x": 0,
        "y": 0,
        "w": 1,
        "h": 1
      },
      "replies": [
        {
          "author": "Rui Matos",
          "comment": "The gradient was a brand request for the launch.",
          "createdAt": "2026-11-11T09:40:00.000Z"
        },
        {
          "agent": "claude-code",
          "comment": "Then it needs a token first: request a \"brand-gradient\" token in #design-system, and ProgressBar can take it as a tone.",
          "createdAt": "2026-11-11T09:42:00.000Z",
          "links": [
            {
              "label": "Acme UI: Requesting a token",
              "url": "https://ui.acme.example/contributing/tokens"
            }
          ]
        }
      ],
      "proposal": {
        "current": "proposals/ds-05-current.png",
        "proposed": "proposals/ds-05-proposed.png",
        "caption": "<ProgressBar label=\"Seats\" value={8} max={10} />\n<ProgressBar label=\"Storage\" value={41} max={50} tone=\"warning\" />"
      }
    },
